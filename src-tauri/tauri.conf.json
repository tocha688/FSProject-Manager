{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectFinder",
  "version": "0.1.1",
  "identifier": "com.local.projectfinder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "项目快搜",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "quick",
        "title": "快速搜索",
        "url": "index.html",
        "width": 680,
        "height": 460,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
